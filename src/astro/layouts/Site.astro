---
import { ClientRouter } from 'astro:transitions';
import Header from '../islands/Header';
import FooterControls from '../islands/FooterControls';
import { SiteFooter } from '../StaticContent';
import { structuredData } from '~/site/seo/structuredData';
import site from '../../../site.config.json';
import katexCssHref from 'katex/dist/katex.min.css?url';
import { resolveOgImagePath } from '~/site/seo/og';
import { contentStatsWordsCount, contentStatsTotalPosts, contentStatsTotalTags, contentStatsTotalCategories, contentStatsPostsByYear, contentStatsZhNavPages, contentStatsEnNavPages } from '../../../tools/content/stats';
import '@unocss/reset/tailwind.css';
import '~/styles/color.css';
import '~/styles/base.css';
import '~/styles/article.css';
import 'virtual:uno.css';
const { title = '首页', description = site.description, lang = 'zh-CN', token, discussionUrl, hasMath, date, updated, keywords = site.keywords.split(", "), words, subtitle, isTranslation } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.baseURL);
const jsonLd = JSON.stringify(structuredData({path: Astro.url.pathname, title, description, date, updated, keywords, words, subtitle, lang})).replace(/</g, '\\u003c');
const translationBase = Astro.url.pathname.replace(/\/$/, '').replace(/-en$/, '');
const pages = lang === 'en' ? contentStatsEnNavPages : contentStatsZhNavPages;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · {site.title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author.name} />
    <meta name="referrer" content="same-origin" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} · ${site.title}`} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "zh_CN"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(resolveOgImagePath(Astro.url.pathname), site.baseURL)} />
    <meta name="keywords" content={keywords.join(", ")} />
    <meta name="date" content={date} />
    <meta name="theme-color" content="#fff" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content={site.title} />
    <meta name="msapplication-starturl" content={site.baseURL} />
    <meta name="msapplication-navbutton-color" content="#065279" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={site.title} />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta property="article:author" content={site.author.name} />
    <script type="application/ld+json" set:html={jsonLd} />
    {isTranslation !== undefined && <><link rel="alternate" hreflang="zh-CN" href={new URL(`${translationBase}/`, site.baseURL)} /><link rel="alternate" hreflang="en" href={new URL(`${translationBase}-en/`, site.baseURL)} /></>}
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(resolveOgImagePath(Astro.url.pathname), site.baseURL)} />
    <meta property="og:type" content={date ? 'article' : 'website'} />
    {date && <meta property="article:published_time" content={date} />}
    {updated && <meta property="article:modified_time" content={updated} />}
    {discussionUrl && <meta name="inkstone:discussion" content={discussionUrl} />}
    {token && <meta name="inkstone:token" content={token} />}
    <link rel="icon" type="image/svg+xml" href="/favicon/light.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon/dark.svg" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/favicon/generated/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="mask-icon" href="/favicon/safari-pinned-tab.svg" color="#1f6f6a" />
    <link rel="alternate" type="application/atom+xml" href="/atom.xml" title={site.title} />
    {hasMath && <link rel="stylesheet" href={katexCssHref} />}
    <ClientRouter />
    <script is:inline data-astro-rerun>
      { let value = 'auto'; try { value = localStorage.getItem('customer-theme') || 'auto'; } catch {}
        document.documentElement.classList.toggle('dark', value === 'dark' || (value === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches)); }
    </script>
  </head>
  <body transition:animate="none">
    <div class="min-h-screen flex flex-col">
      <Header lang={lang} pages={pages} client:load />
      <main class="w-full pb-16 md:pb-20 flex-1"><slot /></main>
      <FooterControls client:load transition:persist="footer-controls" />
      <SiteFooter lang={lang} stats={{posts: contentStatsTotalPosts, categories: contentStatsTotalCategories.length, words: contentStatsWordsCount, tags: contentStatsTotalTags}} categories={contentStatsTotalCategories} years={contentStatsPostsByYear} />
    </div>
    <script>
      import { setupCodeBlocks } from '~/features/article/components/CodeBlockHeader';
      import { trackPage, trackEngage } from '~/utils/track';
      let dispose: (() => void) | undefined;
      document.addEventListener('astro:before-swap', () => { dispose?.(); trackEngage(true); });
      document.addEventListener('astro:page-load', () => {
        const root = document.getElementById('blog-article');
        if (root) dispose = setupCodeBlocks(root, { copyLabel: () => document.documentElement.lang === 'en' ? 'Copy Code' : '复制代码', copiedLabel: () => document.documentElement.lang === 'en' ? 'Copied' : '已复制' });
        const token = document.querySelector<HTMLMetaElement>('meta[name="inkstone:token"]')?.content;
        if (token) trackPage(location.pathname, token);
      });
    </script>
  </body>
</html>
