{
  "name": "wicer-blog",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "content:build": "velite build --clean",
    "dev": "vite dev",
    "build": "vite build",
    "prebuild": "bun content:build",
    "packages:build": "cd packages/inkstone-track && bun run build && bun run build:types",
    "postinstall": "bun run packages:build",
    "start": "npx serve .output/public",
    "preview": "nitro preview",
    "version": "vite --version",
    "clean": "rm -rf .velite node_modules/.vite src/routes/\\(hugo\\) \\(hugo\\) .output public/_data public/sitemap.xml public/atom.xml public/manifest.webmanifest public/posts public/base public/category public/tags public/sass",
    "i18n": "typesafe-i18n",
    "test": "bun test"
  },
  "dependencies": {
    "@wincer/inkstone-track": "workspace:*",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "2.0.0",
    "nitro": "3.0.260610-beta",
    "solid-js": "^1.9.14",
    "typesafe-i18n": "^5.26.2",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/lxgw-wenkai": "^5.2.5",
    "@iconify-json/ph": "^1.2.2",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/rehype": "3.20.0",
    "@types/node": "^24.0.0",
    "@unocss/preset-typography": "^66.7.5",
    "@unocss/preset-wind4": "^66.7.5",
    "@unocss/reset": "^66.7.5",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.22",
    "png2icons": "^2.0.1",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "satori": "^0.18.3",
    "shiki": "3.20.0",
    "typescript": "^5.9.2",
    "unified": "^11.0.5",
    "unocss": "^66.7.5",
    "unplugin-icons": "^22.1.0",
    "velite": "^0.3.1",
    "workbox-core": "^7.3.0",
    "workbox-routing": "^7.3.0"
  }
}
