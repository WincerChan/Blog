{
  "name": "wicer-blog",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "astro dev --port 3001",
    "build": "astro build",
    "packages:build": "cd packages/inkstone-track && bun run build && bun run build:types",
    "postinstall": "bun run packages:build",
    "start": "astro preview --port 4176",
    "preview": "astro preview --port 4176",
    "version": "astro --version",
    "clean": "rm -rf .velite .astro node_modules/.astro .astro-public dist/astro public/_data public/og public/search-index.json public/sitemap.xml public/atom.xml public/manifest.webmanifest public/sass",
    "clean:og": "rm -rf .cache/og",
    "i18n": "typesafe-i18n",
    "test": "bun test",
    "astro:dev": "bun run dev",
    "astro:build": "bun run build",
    "astro:preview": "bun run preview"
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.0.2",
    "@wincer/inkstone-track": "workspace:*",
    "astro": "^7.3.5",
    "solid-js": "^1.9.14",
    "typesafe-i18n": "^5.26.2",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/lxgw-wenkai": "^5.2.5",
    "@iconify-json/ph": "^1.2.2",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/rehype": "3.20.0",
    "@types/node": "^24.0.0",
    "@unocss/preset-typography": "^66.7.5",
    "@unocss/preset-wind4": "^66.7.5",
    "@unocss/reset": "^66.7.5",
    "gray-matter": "^4.0.3",
    "hast-util-raw": "^9.1.0",
    "hast-util-to-string": "^3.0.1",
    "katex": "^0.16.22",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-toc": "^7.1.0",
    "png2icons": "^2.0.1",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "satori": "^0.18.3",
    "sharp": "^0.35.4",
    "shiki": "3.20.0",
    "typescript": "^5.9.2",
    "unified": "^11.0.5",
    "unocss": "^66.7.5",
    "unplugin-icons": "^22.1.0",
    "workbox-core": "^7.3.0",
    "workbox-routing": "^7.3.0"
  }
}
